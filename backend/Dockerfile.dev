# Dockerfile.dev for backend development environment

FROM maven:3.9-eclipse-temurin-25-alpine

WORKDIR /app

# Copy pom.xml and download dependencies
COPY pom.xml .
RUN mvn dependency:go-offline

# Copy source code
COPY src ./src

EXPOSE 8080

# Use spring-boot:run for hot reload in development
CMD ["mvn", "spring-boot:run"]
