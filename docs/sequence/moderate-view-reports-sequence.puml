@startuml
title Moderate Content - View Reports

actor Admin
participant ReportController
participant GetReportsService
participant ReportRepository
participant ReportResponseEnricher
participant PostRepository
participant CommentRepository
participant UserRepository
database Database

Admin -> ReportController: GET /api/reports?status=PENDING&page=0&size=20
activate ReportController

ReportController -> GetReportsService: getReports(PENDING, 0, 20)
activate GetReportsService

GetReportsService -> ReportRepository: findByStatus(PENDING, page, size)
ReportRepository -> Database: SELECT * FROM reports\nWHERE status = 'PENDING'\nORDER BY created_at DESC\nLIMIT 20 OFFSET 0
Database --> ReportRepository: report rows
ReportRepository --> GetReportsService: Page<Report>

GetReportsService -> ReportResponseEnricher: enrich(reportResponses)
activate ReportResponseEnricher

loop for each report
    alt targetType == POST
        ReportResponseEnricher -> PostRepository: findById(targetId)
        PostRepository -> Database: SELECT * FROM posts WHERE id = ?
        Database --> PostRepository: post row
        PostRepository --> ReportResponseEnricher: Optional<Post>
    else targetType == COMMENT
        ReportResponseEnricher -> CommentRepository: findById(targetId)
        CommentRepository -> Database: SELECT * FROM comments WHERE id = ?
        Database --> CommentRepository: comment row
        CommentRepository --> ReportResponseEnricher: Optional<Comment>
    else targetType == USER
        ReportResponseEnricher -> UserRepository: findById(targetId)
        UserRepository -> Database: SELECT * FROM users WHERE id = ?
        Database --> UserRepository: user row
        UserRepository --> ReportResponseEnricher: Optional<User>
    end
end

ReportResponseEnricher --> GetReportsService: List<ReportResponse> (enriched)
deactivate ReportResponseEnricher

GetReportsService --> ReportController: PageResponse<ReportResponse>
deactivate GetReportsService

ReportController --> Admin: 200 OK (paginated reports with target content)
deactivate ReportController

@enduml
