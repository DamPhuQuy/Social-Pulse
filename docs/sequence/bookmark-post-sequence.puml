@startuml
!theme plain

title Bookmark Post Endpoint Sequence - POST /api/v1/bookmarks/posts/{postId}

autonumber

actor Member
participant BookmarkController
participant CreateBookmarkUseCase
participant CreateBookmarkService
database BookmarkRepository
database PostRepository
participant BookmarkResponseMapper

Member -> BookmarkController: POST /api/v1/bookmarks/posts/{postId}\n[Authorization]
BookmarkController -> CreateBookmarkUseCase: createBookmark(postId, currentUser)
CreateBookmarkUseCase -> CreateBookmarkService: createBookmark()

CreateBookmarkService -> BookmarkRepository: findByUserIdAndPostId(userId, postId)
BookmarkRepository --> CreateBookmarkService: existingBookmark (optional)

alt Bookmark already exists
  CreateBookmarkService -> BookmarkResponseMapper: toResponse(existingBookmark)
  BookmarkResponseMapper --> CreateBookmarkService: BookmarkResponse
  CreateBookmarkService --> BookmarkController: BookmarkResponse
else Bookmark does not exist
  CreateBookmarkService -> PostRepository: findById(postId)
  PostRepository --> CreateBookmarkService: Post
  
  alt Post not found or deleted
    CreateBookmarkService --> BookmarkController: throw POST_NOT_FOUND
    BookmarkController --> Member: 404 Not Found
  else Post privacy check failed
    CreateBookmarkService --> BookmarkController: throw POST_NOT_ACCESSIBLE
    BookmarkController --> Member: 403 Forbidden
  end
  
  CreateBookmarkService -> BookmarkRepository: save(Bookmark)
  BookmarkRepository --> CreateBookmarkService: savedBookmark
  
  CreateBookmarkService -> BookmarkResponseMapper: toResponse(savedBookmark)
  BookmarkResponseMapper --> CreateBookmarkService: BookmarkResponse
end

CreateBookmarkService --> CreateBookmarkUseCase: BookmarkResponse
CreateBookmarkUseCase --> BookmarkController: BookmarkResponse
BookmarkController --> Member: 200 OK\nApiResponse<BookmarkResponse>

@enduml
