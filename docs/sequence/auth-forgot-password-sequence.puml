@startuml
!theme plain

title Auth Endpoint Sequence - POST /api/v1/auth/forgot-password

autonumber

actor Client
participant AuthController
participant PasswordResetService
database UserRepository
participant OtpService
database Redis
participant EmailService

Client -> AuthController: POST /api/v1/auth/forgot-password\nForgotPasswordRequest
AuthController -> PasswordResetService: processForgotPassword(request)
PasswordResetService -> UserRepository: findByEmail(email)

alt User not found
  UserRepository --> PasswordResetService: empty
  PasswordResetService --> AuthController: throw USER_NOT_FOUND
  AuthController --> Client: 404 Not Found
else User found
  UserRepository --> PasswordResetService: User
  PasswordResetService -> OtpService: generateToStoreAndSendEmail(email)
  OtpService -> Redis: save otp hash + ttl
  OtpService -> EmailService: sendOtpEmail(email, otpCode)
  EmailService --> OtpService: sent
  OtpService --> PasswordResetService: done
  PasswordResetService --> AuthController: return
  AuthController --> Client: 200 OK
end

@enduml
