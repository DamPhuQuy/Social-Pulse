@startuml
!theme plain

title Search and Discovery Sequence - GET /api/v1/discovery/posts & POST /api/v1/discovery/history

autonumber

actor Member
participant DiscoveryController
participant SearchPostsUseCase
database PostRepository
participant SaveSearchHistoryUseCase
database SearchHistoryRepository

group Search Posts Flow
  Member -> DiscoveryController: GET /api/v1/discovery/posts?q={query}&page=0&size=20\n[Authorization]
  DiscoveryController -> SearchPostsUseCase: searchPosts(query, page, size)
  SearchPostsUseCase -> PostRepository: searchPostsByTextOrTag(query, pageable)
  PostRepository --> SearchPostsUseCase: Page<PostEntity>
  SearchPostsUseCase --> DiscoveryController: PageResponse<UserPostResponse>
  DiscoveryController --> Member: 200 OK\nApiResponse<PageResponse<UserPostResponse>>
end

group Save Search Keyword Flow
  Member -> DiscoveryController: POST /api/v1/discovery/history\nPayload: [keyword]
  DiscoveryController -> SaveSearchHistoryUseCase: saveSearchHistory(userId, request)
  
  SaveSearchHistoryUseCase -> SearchHistoryRepository: findByUserIdAndKeyword(userId, keyword)
  SearchHistoryRepository --> SaveSearchHistoryUseCase: existingHistory (optional)
  
  alt Keyword exists in history
    SaveSearchHistoryUseCase -> SearchHistoryRepository: updateTimestamp(existingHistoryId, now)
  else New keyword
    SaveSearchHistoryUseCase -> SearchHistoryRepository: countByUserId(userId)
    SearchHistoryRepository --> SaveSearchHistoryUseCase: count (int)
    
    alt count >= 20 (FIFO Limit)
      SaveSearchHistoryUseCase -> SearchHistoryRepository: deleteOldestSearchHistory(userId)
    end
    
    SaveSearchHistoryUseCase -> SearchHistoryRepository: save(SearchHistory)
  end
  
  SaveSearchHistoryUseCase --> DiscoveryController: void
  DiscoveryController --> Member: 200 OK\nApiResponse<Void>
end

@enduml
