end

@enduml

@startuml
title DELETE /api/notifications/{notificationId} - Delete Notification

actor Client
participant AuthFilter
participant NotificationController
participant DeleteNotificationService
participant NotificationRepository
database Database

Client -> AuthFilter: DELETE /api/notifications/{notificationId}
AuthFilter -> AuthFilter: validate JWT
AuthFilter -> NotificationController: forward request with currentUserId
activate NotificationController

NotificationController -> DeleteNotificationService: deleteNotification(notificationId, currentUserId)
activate DeleteNotificationService

DeleteNotificationService -> NotificationRepository: findById(notificationId)
NotificationRepository -> Database: SELECT * FROM notifications WHERE id = ?
Database --> NotificationRepository: notification row
NotificationRepository --> DeleteNotificationService: Optional<Notification>

alt Notification not found
    DeleteNotificationService --> NotificationController: NotificationNotFoundException
    NotificationController --> Client: 404 Not Found
else Notification found
    DeleteNotificationService -> DeleteNotificationService: check ownership\n(notification.userId == currentUserId)

    alt Not owner
        DeleteNotificationService --> NotificationController: ForbiddenException
        NotificationController --> Client: 403 Forbidden
    else Owner
        DeleteNotificationService -> NotificationRepository: delete(notification)
        NotificationRepository -> Database: DELETE FROM notifications WHERE id = ?
        Database --> NotificationRepository: void

        DeleteNotificationService --> NotificationController: void
        deactivate DeleteNotificationService

        NotificationController --> Client: 204 No Content
        deactivate NotificationController
    end
end

alt Unauthorized
    AuthFilter --> Client: 401 Unauthorized
end

@enduml

@startuml
title GET /api/notifications/unread-count - Get Unread Notification Count

actor Client
participant AuthFilter
participant NotificationController
participant GetUnreadCountService
participant NotificationRepository
database Database

Client -> AuthFilter: GET /api/notifications/unread-count
AuthFilter -> AuthFilter: validate JWT
AuthFilter -> NotificationController: forward request with currentUserId
activate NotificationController

NotificationController -> GetUnreadCountService: getUnreadCount(currentUserId)
activate GetUnreadCountService

GetUnreadCountService -> NotificationRepository: countUnreadByUserId(currentUserId)
NotificationRepository -> Database: SELECT COUNT(*) FROM notifications\nWHERE user_id = ? AND is_read = false
Database --> NotificationRepository: count
NotificationRepository --> GetUnreadCountService: long

GetUnreadCountService --> NotificationController: UnreadCountResponse(count)
deactivate GetUnreadCountService

NotificationController --> Client: 200 OK(response)
deactivate NotificationController

alt Unauthorized
    AuthFilter --> Client: 401 Unauthorized
end

@enduml
