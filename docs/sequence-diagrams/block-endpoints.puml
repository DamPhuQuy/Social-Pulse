@startuml
title POST /api/users/{userId}/block - Block User

actor Client
participant AuthFilter
participant BlockController
participant BlockUserService
participant UserRepository
participant BlockRepository
participant FollowRepository
database Database

Client -> AuthFilter: POST /api/users/{userId}/block
AuthFilter -> AuthFilter: validate JWT
AuthFilter -> BlockController: forward request with currentUserId
activate BlockController

BlockController -> BlockUserService: blockUser(userId, currentUserId)
activate BlockUserService

BlockUserService -> BlockUserService: validate not blocking self

alt Blocking self
    BlockUserService --> BlockController: InvalidOperationException
    BlockController --> Client: 400 Bad Request
else Valid operation
    BlockUserService -> UserRepository: findById(userId)
    UserRepository -> Database: SELECT * FROM users WHERE id = ?
    Database --> UserRepository: user row
    UserRepository --> BlockUserService: Optional<User>

    alt User not found
        BlockUserService --> BlockController: UserNotFoundException
        BlockController --> Client: 404 Not Found
    else User found
        BlockUserService -> BlockRepository: existsByBlockerIdAndBlockedId(currentUserId, userId)
        BlockRepository -> Database: SELECT COUNT(*) FROM blocks\nWHERE blocker_id = ? AND blocked_id = ?
        Database --> BlockRepository: count
        BlockRepository --> BlockUserService: boolean

        alt Already blocked
            BlockUserService --> BlockController: AlreadyBlockedException
            BlockController --> Client: 409 Conflict
        else Not blocked yet
            BlockUserService -> BlockUserService: begin transaction

            BlockUserService -> BlockUserService: create Block entity

            BlockUserService -> BlockRepository: save(block)
            BlockRepository -> Database: INSERT INTO blocks
            Database --> BlockRepository: saved block
            BlockRepository --> BlockUserService: Block

            BlockUserService -> FollowRepository: deleteByFollowerIdAndFollowedId(currentUserId, userId)
            FollowRepository -> Database: DELETE FROM follows\nWHERE follower_id = ? AND followed_id = ?
            Database --> FollowRepository: deleted count

            BlockUserService -> FollowRepository: deleteByFollowerIdAndFollowedId(userId, currentUserId)
            FollowRepository -> Database: DELETE FROM follows\nWHERE follower_id = ? AND followed_id = ?
            Database --> FollowRepository: deleted count

            BlockUserService -> BlockUserService: commit transaction

            BlockUserService --> BlockController: BlockResponse
            deactivate BlockUserService

            BlockController --> Client: 201 Created(response)
            deactivate BlockController
        end
    end
end

alt Unauthorized
    AuthFilter --> Client: 401 Unauthorized
end

@enduml

@startuml
title DELETE /api/users/{userId}/block - Unblock User

actor Client
participant AuthFilter
participant BlockController
participant UnblockUserService
participant UserRepository
participant BlockRepository
database Database

Client -> AuthFilter: DELETE /api/users/{userId}/block
AuthFilter -> AuthFilter: validate JWT
AuthFilter -> BlockController: forward request with currentUserId
activate BlockController

BlockController -> UnblockUserService: unblockUser(userId, currentUserId)
activate UnblockUserService

UnblockUserService -> UnblockUserService: validate not unblocking self

alt Unblocking self
    UnblockUserService --> BlockController: InvalidOperationException
    BlockController --> Client: 400 Bad Request
else Valid operation
    UnblockUserService -> UserRepository: findById(userId)
    UserRepository -> Database: SELECT * FROM users WHERE id = ?
    Database --> UserRepository: user row
    UserRepository --> UnblockUserService: Optional<User>

    alt User not found
        UnblockUserService --> BlockController: UserNotFoundException
        BlockController --> Client: 404 Not Found
    else User found
        UnblockUserService -> BlockRepository: findByBlockerIdAndBlockedId(currentUserId, userId)
        BlockRepository -> Database: SELECT * FROM blocks\nWHERE blocker_id = ? AND blocked_id = ?
        Database --> BlockRepository: block row
        BlockRepository --> UnblockUserService: Optional<Block>

        alt Not blocked
            UnblockUserService --> BlockController: NotBlockedException
            UnblockUserService --> Client: 404 Not Found
        else Blocked
            UnblockUserService -> BlockRepository: delete(block)
            BlockRepository -> Database: DELETE FROM blocks WHERE id = ?
            Database --> BlockRepository: void

            UnblockUserService --> BlockController: void
            deactivate UnblockUserService

            BlockController --> Client: 204 No Content
            deactivate BlockController
        end
    end
end

alt Unauthorized
    AuthFilter --> Client: 401 Unauthorized
end

@enduml

@startuml
title GET /api/users/blocked - Get Blocked Users

actor Client
participant AuthFilter
participant BlockController
participant GetBlockedUsersService
participant BlockRepository
participant UserRepository
participant UserMapper
database Database

Client -> AuthFilter: GET /api/users/blocked?page={page}&size={size}
AuthFilter -> AuthFilter: validate JWT
AuthFilter -> BlockController: forward request with currentUserId
activate BlockController

BlockController -> GetBlockedUsersService: getBlockedUsers(currentUserId, pageable)
activate GetBlockedUsersService

GetBlockedUsersService -> BlockRepository: findBlockedUsersByBlockerId(currentUserId, pageable)
BlockRepository -> Database: SELECT u.* FROM users u\nINNER JOIN blocks b ON u.id = b.blocked_id\nWHERE b.blocker_id = ?\nORDER BY b.created_at DESC\nLIMIT ? OFFSET ?
Database --> BlockRepository: user rows
BlockRepository --> GetBlockedUsersService: Page<User>

loop for each blocked user
    GetBlockedUsersService -> UserMapper: toUserSummaryResponse(user)
    UserMapper --> GetBlockedUsersService: UserSummaryResponse
end

GetBlockedUsersService --> BlockController: Page<UserSummaryResponse>
deactivate GetBlockedUsersService

BlockController --> Client: 200 OK(response)
deactivate BlockController

alt Unauthorized
    AuthFilter --> Client: 401 Unauthorized
end

@enduml
