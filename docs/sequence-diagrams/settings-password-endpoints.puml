@startuml
title PUT /api/users/me/password - Change Password

actor Client
participant AuthFilter
participant UserController
participant ChangePasswordService
participant UserRepository
participant PasswordEncoder
database Database

Client -> AuthFilter: PUT /api/users/me/password(ChangePasswordRequest)
AuthFilter -> AuthFilter: validate JWT
AuthFilter -> UserController: forward request with currentUserId
activate UserController

UserController -> ChangePasswordService: changePassword(currentUserId, request)
activate ChangePasswordService

ChangePasswordService -> ChangePasswordService: validate request\n(oldPassword, newPassword)

ChangePasswordService -> UserRepository: findById(currentUserId)
UserRepository -> Database: SELECT * FROM users WHERE id = ?
Database --> UserRepository: user row
UserRepository --> ChangePasswordService: Optional<User>

alt User not found
    ChangePasswordService --> UserController: UserNotFoundException
    UserController --> Client: 404 Not Found
else User found
    ChangePasswordService -> PasswordEncoder: matches(oldPassword, user.password)
    PasswordEncoder --> ChangePasswordService: boolean

    alt Old password incorrect
        ChangePasswordService --> UserController: InvalidPasswordException
        UserController --> Client: 400 Bad Request
    else Old password correct
        ChangePasswordService -> PasswordEncoder: encode(newPassword)
        PasswordEncoder --> ChangePasswordService: encodedPassword

        ChangePasswordService -> ChangePasswordService: update User entity\n(password = encodedPassword)

        ChangePasswordService -> UserRepository: save(user)
        UserRepository -> Database: UPDATE users SET password = ?\nWHERE id = ?
        Database --> UserRepository: updated user
        UserRepository --> ChangePasswordService: User

        ChangePasswordService --> UserController: ChangePasswordResponse
        deactivate ChangePasswordService

        UserController --> Client: 200 OK(response)
        deactivate UserController
    end
end

alt Unauthorized
    AuthFilter --> Client: 401 Unauthorized
end

@enduml

@startuml
title POST /api/auth/forgot-password - Request Password Reset

actor Client
participant AuthController
participant ForgotPasswordService
participant UserRepository
participant PasswordResetTokenRepository
participant EmailService
database Database

Client -> AuthController: POST /api/auth/forgot-password(ForgotPasswordRequest)
activate AuthController

AuthController -> ForgotPasswordService: requestPasswordReset(email)
activate ForgotPasswordService

ForgotPasswordService -> UserRepository: findByEmail(email)
UserRepository -> Database: SELECT * FROM users WHERE email = ?
Database --> UserRepository: user row
UserRepository --> ForgotPasswordService: Optional<User>

alt User not found
    ForgotPasswordService -> ForgotPasswordService: silent success\n(security: don't reveal user existence)
    ForgotPasswordService --> AuthController: PasswordResetResponse
    AuthController --> Client: 200 OK(response)
else User found
    ForgotPasswordService -> ForgotPasswordService: generate reset token\n(UUID, expiry = 1 hour)

    ForgotPasswordService -> PasswordResetTokenRepository: save(token)
    PasswordResetTokenRepository -> Database: INSERT INTO password_reset_tokens
    Database --> PasswordResetTokenRepository: saved token
    PasswordResetTokenRepository --> ForgotPasswordService: PasswordResetToken

    ForgotPasswordService -> EmailService: sendPasswordResetEmail(email, token)
    EmailService --> ForgotPasswordService: void

    ForgotPasswordService --> AuthController: PasswordResetResponse
    deactivate ForgotPasswordService

    AuthController --> Client: 200 OK(response)
    deactivate AuthController
end

@enduml

@startuml
title POST /api/auth/reset-password - Reset Password

actor Client
participant AuthController
participant ResetPasswordService
participant PasswordResetTokenRepository
participant UserRepository
participant PasswordEncoder
database Database

Client -> AuthController: POST /api/auth/reset-password(ResetPasswordRequest)
activate AuthController

AuthController -> ResetPasswordService: resetPassword(token, newPassword)
activate ResetPasswordService

ResetPasswordService -> PasswordResetTokenRepository: findByToken(token)
PasswordResetTokenRepository -> Database: SELECT * FROM password_reset_tokens\nWHERE token = ?
Database --> PasswordResetTokenRepository: token row
PasswordResetTokenRepository --> ResetPasswordService: Optional<PasswordResetToken>

alt Token not found
    ResetPasswordService --> AuthController: InvalidTokenException
    AuthController --> Client: 400 Bad Request
else Token found
    ResetPasswordService -> ResetPasswordService: validate token not expired

    alt Token expired
        ResetPasswordService --> AuthController: TokenExpiredException
        AuthController --> Client: 400 Bad Request
    else Token valid
        ResetPasswordService -> UserRepository: findById(token.userId)
        UserRepository -> Database: SELECT * FROM users WHERE id = ?
        Database --> UserRepository: user row
        UserRepository --> ResetPasswordService: Optional<User>

        ResetPasswordService -> PasswordEncoder: encode(newPassword)
        PasswordEncoder --> ResetPasswordService: encodedPassword

        ResetPasswordService -> ResetPasswordService: begin transaction

        ResetPasswordService -> ResetPasswordService: update User entity\n(password = encodedPassword)

        ResetPasswordService -> UserRepository: save(user)
        UserRepository -> Database: UPDATE users SET password = ?\nWHERE id = ?
        Database --> UserRepository: updated user
        UserRepository --> ResetPasswordService: User

        ResetPasswordService -> PasswordResetTokenRepository: delete(token)
        PasswordResetTokenRepository -> Database: DELETE FROM password_reset_tokens\nWHERE id = ?
        Database --> PasswordResetTokenRepository: void

        ResetPasswordService -> PasswordResetTokenRepository: deleteAllByUserId(userId)
        PasswordResetTokenRepository -> Database: DELETE FROM password_reset_tokens\nWHERE user_id = ?
        Database --> PasswordResetTokenRepository: void

        ResetPasswordService -> ResetPasswordService: commit transaction

        ResetPasswordService --> AuthController: ResetPasswordResponse
        deactivate ResetPasswordService

        AuthController --> Client: 200 OK(response)
        deactivate AuthController
    end
end

@enduml
