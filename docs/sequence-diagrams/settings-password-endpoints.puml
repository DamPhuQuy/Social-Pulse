@startuml
title PUT /api/users/me/settings - Update User Settings

actor Client
participant AuthFilter
participant SettingsController
participant UpdateSettingsService
participant UserRepository
participant UserSettingsRepository
database Database

Client -> AuthFilter: PUT /api/users/me/settings(UpdateSettingsRequest)
AuthFilter -> AuthFilter: validate JWT
AuthFilter -> SettingsController: forward request with currentUserId
activate SettingsController

SettingsController -> UpdateSettingsService: updateSettings(currentUserId, request)
activate UpdateSettingsService

UpdateSettingsService -> UserRepository: findById(currentUserId)
UserRepository -> Database: SELECT * FROM users WHERE id = ?
Database --> UserRepository: user row
UserRepository --> UpdateSettingsService: Optional<User>

alt User not found
    UpdateSettingsService --> SettingsController: UserNotFoundException
    SettingsController --> Client: 404 Not Found
else User found
    UpdateSettingsService -> UserSettingsRepository: findByUserId(currentUserId)
    UserSettingsRepository -> Database: SELECT * FROM user_settings WHERE user_id = ?
    Database --> UserSettingsRepository: settings row
    UserSettingsRepository --> UpdateSettingsService: Optional<UserSettings>

    alt Settings not found
        UpdateSettingsService -> UpdateSettingsService: create new UserSettings entity
    else Settings found
        UpdateSettingsService -> UpdateSettingsService: update UserSettings entity
    end

    UpdateSettingsService -> UpdateSettingsService: apply request changes\n(privacy, notifications, language)

    UpdateSettingsService -> UserSettingsRepository: save(settings)
    UserSettingsRepository -> Database: INSERT/UPDATE user_settings
    Database --> UserSettingsRepository: saved settings
    UserSettingsRepository --> UpdateSettingsService: UserSettings

    UpdateSettingsService --> SettingsController: UserSettingsResponse
    deactivate UpdateSettingsService

    SettingsController --> Client: 200 OK(response)
    deactivate SettingsController
end

alt Unauthorized
    AuthFilter --> Client: 401 Unauthorized
end

@enduml

