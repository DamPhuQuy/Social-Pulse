@startuml
title POST /api/users/{userId}/follow - Follow User

actor Client
participant AuthFilter
participant FollowController
participant FollowUserService
participant UserRepository
participant FollowRepository
database Database

Client -> AuthFilter: POST /api/users/{userId}/follow
AuthFilter -> AuthFilter: validate JWT
AuthFilter -> FollowController: forward request with currentUserId
activate FollowController

FollowController -> FollowUserService: followUser(userId, currentUserId)
activate FollowUserService

FollowUserService -> FollowUserService: validate not following self

alt Following self
    FollowUserService --> FollowController: InvalidOperationException
    FollowController --> Client: 400 Bad Request
else Valid operation
    FollowUserService -> UserRepository: findById(userId)
    UserRepository -> Database: SELECT * FROM users WHERE id = ?
    Database --> UserRepository: user row
    UserRepository --> FollowUserService: Optional<User>

    alt User not found
        FollowUserService --> FollowController: UserNotFoundException
        FollowController --> Client: 404 Not Found
    else User found
        FollowUserService -> FollowRepository: existsByFollowerIdAndFollowedId(currentUserId, userId)
        FollowRepository -> Database: SELECT COUNT(*) FROM follows\nWHERE follower_id = ? AND followed_id = ?
        Database --> FollowRepository: count
        FollowRepository --> FollowUserService: boolean

        alt Already following
            FollowUserService --> FollowController: AlreadyFollowingException
            FollowController --> Client: 409 Conflict
        else Not following yet
            FollowUserService -> FollowUserService: begin transaction

            FollowUserService -> FollowUserService: create Follow entity

            FollowUserService -> FollowRepository: save(follow)
            FollowRepository -> Database: INSERT INTO follows
            Database --> FollowRepository: saved follow
            FollowRepository --> FollowUserService: Follow

            FollowUserService -> UserRepository: incrementFollowerCount(userId)
            UserRepository -> Database: UPDATE users SET follower_count = follower_count + 1\nWHERE id = ?
            Database --> UserRepository: void

            FollowUserService -> UserRepository: incrementFollowingCount(currentUserId)
            UserRepository -> Database: UPDATE users SET following_count = following_count + 1\nWHERE id = ?
            Database --> UserRepository: void

            FollowUserService -> FollowUserService: commit transaction

            FollowUserService --> FollowController: FollowResponse
            deactivate FollowUserService

            FollowController --> Client: 201 Created(response)
            deactivate FollowController
        end
    end
end

alt Unauthorized
    AuthFilter --> Client: 401 Unauthorized
end

@enduml

@startuml
title DELETE /api/users/{userId}/follow - Unfollow User

actor Client
participant AuthFilter
participant FollowController
participant UnfollowUserService
participant UserRepository
participant FollowRepository
database Database

Client -> AuthFilter: DELETE /api/users/{userId}/follow
AuthFilter -> AuthFilter: validate JWT
AuthFilter -> FollowController: forward request with currentUserId
activate FollowController

FollowController -> UnfollowUserService: unfollowUser(userId, currentUserId)
activate UnfollowUserService

UnfollowUserService -> UnfollowUserService: validate not unfollowing self

alt Unfollowing self
    UnfollowUserService --> FollowController: InvalidOperationException
    FollowController --> Client: 400 Bad Request
else Valid operation
    UnfollowUserService -> UserRepository: findById(userId)
    UserRepository -> Database: SELECT * FROM users WHERE id = ?
    Database --> UserRepository: user row
    UserRepository --> UnfollowUserService: Optional<User>

    alt User not found
        UnfollowUserService --> FollowController: UserNotFoundException
        FollowController --> Client: 404 Not Found
    else User found
        UnfollowUserService -> FollowRepository: findByFollowerIdAndFollowedId(currentUserId, userId)
        FollowRepository -> Database: SELECT * FROM follows\nWHERE follower_id = ? AND followed_id = ?
        Database --> FollowRepository: follow row
        FollowRepository --> UnfollowUserService: Optional<Follow>

        alt Not following
            UnfollowUserService --> FollowController: NotFollowingException
            FollowController --> Client: 404 Not Found
        else Following
            UnfollowUserService -> UnfollowUserService: begin transaction

            UnfollowUserService -> FollowRepository: delete(follow)
            FollowRepository -> Database: DELETE FROM follows WHERE id = ?
            Database --> FollowRepository: void

            UnfollowUserService -> UserRepository: decrementFollowerCount(userId)
            UserRepository -> Database: UPDATE users SET follower_count = follower_count - 1\nWHERE id = ?
            Database --> UserRepository: void

            UnfollowUserService -> UserRepository: decrementFollowingCount(currentUserId)
            UserRepository -> Database: UPDATE users SET following_count = following_count - 1\nWHERE id = ?
            Database --> UserRepository: void

            UnfollowUserService -> UnfollowUserService: commit transaction

            UnfollowUserService --> FollowController: void
            deactivate UnfollowUserService

            FollowController --> Client: 204 No Content
            deactivate FollowController
        end
    end
end

alt Unauthorized
    AuthFilter --> Client: 401 Unauthorized
end

@enduml

@startuml
title GET /api/users/{userId}/followers - Get User Followers

actor Client
participant AuthFilter
participant FollowController
participant GetFollowersService
participant UserRepository
participant FollowRepository
participant UserMapper
database Database

Client -> AuthFilter: GET /api/users/{userId}/followers?page={page}&size={size}
AuthFilter -> AuthFilter: validate JWT (optional)
AuthFilter -> FollowController: forward request with currentUserId (if authenticated)
activate FollowController

FollowController -> GetFollowersService: getFollowers(userId, pageable, currentUserId)
activate GetFollowersService

GetFollowersService -> UserRepository: findById(userId)
UserRepository -> Database: SELECT * FROM users WHERE id = ?
Database --> UserRepository: user row
UserRepository --> GetFollowersService: Optional<User>

alt User not found
    GetFollowersService --> FollowController: UserNotFoundException
    FollowController --> Client: 404 Not Found
else User found
    GetFollowersService -> FollowRepository: findFollowersByUserId(userId, pageable)
    FollowRepository -> Database: SELECT u.* FROM users u\nINNER JOIN follows f ON u.id = f.follower_id\nWHERE f.followed_id = ?\nORDER BY f.created_at DESC\nLIMIT ? OFFSET ?
    Database --> FollowRepository: user rows
    FollowRepository --> GetFollowersService: Page<User>

    loop for each follower
        opt currentUserId provided
            GetFollowersService -> GetFollowersService: check if current user follows this follower
        end

        GetFollowersService -> UserMapper: toUserSummaryResponse(user, isFollowing)
        UserMapper --> GetFollowersService: UserSummaryResponse
    end

    GetFollowersService --> FollowController: Page<UserSummaryResponse>
    deactivate GetFollowersService

    FollowController --> Client: 200 OK(response)
    deactivate FollowController
end

@enduml

