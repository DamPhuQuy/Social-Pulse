@startuml
title GET /api/posts/{postId}/likes - Get Post Likes

actor Client
participant AuthFilter
participant LikeController
participant GetPostLikesService
participant PostRepository
participant LikeRepository
participant UserRepository
participant UserMapper
database Database

Client -> AuthFilter: GET /api/posts/{postId}/likes?page={page}&size={size}
AuthFilter -> AuthFilter: validate JWT (optional)
AuthFilter -> LikeController: forward request with currentUserId (if authenticated)
activate LikeController

LikeController -> GetPostLikesService: getPostLikes(postId, pageable)
activate GetPostLikesService

GetPostLikesService -> PostRepository: findById(postId)
PostRepository -> Database: SELECT * FROM posts WHERE id = ?
Database --> PostRepository: post row
PostRepository --> GetPostLikesService: Optional<Post>

alt Post not found
    GetPostLikesService --> LikeController: PostNotFoundException
    LikeController --> Client: 404 Not Found
else Post found
    GetPostLikesService -> GetPostLikesService: check post visibility\nand access permission

    alt No access to post
        GetPostLikesService --> LikeController: ForbiddenException
        LikeController --> Client: 403 Forbidden
    else Has access
        GetPostLikesService -> LikeRepository: findByPostId(postId, pageable)
        LikeRepository -> Database: SELECT * FROM likes\nWHERE post_id = ?\nORDER BY created_at DESC\nLIMIT ? OFFSET ?
        Database --> LikeRepository: like rows
        LikeRepository --> GetPostLikesService: Page<Like>

        loop for each like
            GetPostLikesService -> UserRepository: findById(like.userId)
            UserRepository -> Database: SELECT * FROM users WHERE id = ?
            Database --> UserRepository: user row
            UserRepository --> GetPostLikesService: Optional<User>

            GetPostLikesService -> UserMapper: toUserSummaryResponse(user)
            UserMapper --> GetPostLikesService: UserSummaryResponse
        end

        GetPostLikesService --> LikeController: Page<UserSummaryResponse>
        deactivate GetPostLikesService

        LikeController --> Client: 200 OK(response)
        deactivate LikeController
    end
end

@enduml
