@startuml
title POST /api/posts/{postId}/like - Like Post

actor Client
participant AuthFilter
participant LikeController
participant LikePostService
participant PostRepository
participant LikeRepository
database Database

Client -> AuthFilter: POST /api/posts/{postId}/like
AuthFilter -> AuthFilter: validate JWT
AuthFilter -> LikeController: forward request with currentUserId
activate LikeController

LikeController -> LikePostService: likePost(postId, currentUserId)
activate LikePostService

LikePostService -> PostRepository: findById(postId)
PostRepository -> Database: SELECT * FROM posts WHERE id = ?
Database --> PostRepository: post row
PostRepository --> LikePostService: Optional<Post>

alt Post not found
    LikePostService --> LikeController: PostNotFoundException
    LikeController --> Client: 404 Not Found
else Post found
    LikePostService -> LikePostService: check post visibility\nand access permission

    alt No access to post
        LikePostService --> LikeController: ForbiddenException
        LikeController --> Client: 403 Forbidden
    else Has access
        LikePostService -> LikeRepository: existsByPostIdAndUserId(postId, currentUserId)
        LikeRepository -> Database: SELECT COUNT(*) FROM likes\nWHERE post_id = ? AND user_id = ?
        Database --> LikeRepository: count
        LikeRepository --> LikePostService: boolean

        alt Already liked
            LikePostService --> LikeController: AlreadyLikedException
            LikeController --> Client: 409 Conflict
        else Not liked yet
            LikePostService -> LikePostService: begin transaction

            LikePostService -> LikePostService: create Like entity

            LikePostService -> LikeRepository: save(like)
            LikeRepository -> Database: INSERT INTO likes
            Database --> LikeRepository: saved like
            LikeRepository --> LikePostService: Like

            LikePostService -> PostRepository: incrementLikeCount(postId)
            PostRepository -> Database: UPDATE posts SET like_count = like_count + 1\nWHERE id = ?
            Database --> PostRepository: void

            LikePostService -> LikePostService: commit transaction

            LikePostService --> LikeController: LikeResponse
            deactivate LikePostService

            LikeController --> Client: 201 Created(response)
            deactivate LikeController
        end
    end
end

alt Unauthorized
    AuthFilter --> Client: 401 Unauthorized
end

@enduml

@startuml
title DELETE /api/posts/{postId}/like - Unlike Post

actor Client
participant AuthFilter
participant LikeController
participant UnlikePostService
participant PostRepository
participant LikeRepository
database Database

Client -> AuthFilter: DELETE /api/posts/{postId}/like
AuthFilter -> AuthFilter: validate JWT
AuthFilter -> LikeController: forward request with currentUserId
activate LikeController

LikeController -> UnlikePostService: unlikePost(postId, currentUserId)
activate UnlikePostService

UnlikePostService -> PostRepository: findById(postId)
PostRepository -> Database: SELECT * FROM posts WHERE id = ?
Database --> PostRepository: post row
PostRepository --> UnlikePostService: Optional<Post>

alt Post not found
    UnlikePostService --> LikeController: PostNotFoundException
    LikeController --> Client: 404 Not Found
else Post found
    UnlikePostService -> LikeRepository: findByPostIdAndUserId(postId, currentUserId)
    LikeRepository -> Database: SELECT * FROM likes\nWHERE post_id = ? AND user_id = ?
    Database --> LikeRepository: like row
    LikeRepository --> UnlikePostService: Optional<Like>

    alt Like not found
        UnlikePostService --> LikeController: LikeNotFoundException
        LikeController --> Client: 404 Not Found
    else Like found
        UnlikePostService -> UnlikePostService: begin transaction

        UnlikePostService -> LikeRepository: delete(like)
        LikeRepository -> Database: DELETE FROM likes WHERE id = ?
        Database --> LikeRepository: void

        UnlikePostService -> PostRepository: decrementLikeCount(postId)
        PostRepository -> Database: UPDATE posts SET like_count = like_count - 1\nWHERE id = ?
        Database --> PostRepository: void

        UnlikePostService -> UnlikePostService: commit transaction

        UnlikePostService --> LikeController: void
        deactivate UnlikePostService

        LikeController --> Client: 204 No Content
        deactivate LikeController
    end
end

alt Unauthorized
    AuthFilter --> Client: 401 Unauthorized
end

