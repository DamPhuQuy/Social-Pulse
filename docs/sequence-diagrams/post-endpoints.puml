@startuml
title POST /api/posts - Create Post

actor Client
participant AuthFilter
participant PostController
participant CreatePostService
participant UserRepository
participant PostRepository
participant FileStorageService
database Database

Client -> AuthFilter: POST /api/posts(CreatePostRequest)
AuthFilter -> AuthFilter: validate JWT
AuthFilter -> PostController: forward request with currentUserId
activate PostController

PostController -> CreatePostService: createPost(currentUserId, request)
activate CreatePostService

CreatePostService -> CreatePostService: validate request\n(content, media)

CreatePostService -> UserRepository: findById(currentUserId)
UserRepository -> Database: SELECT * FROM users WHERE id = ?
Database --> UserRepository: user row
UserRepository --> CreatePostService: Optional<User>

alt User not found
    CreatePostService --> PostController: UserNotFoundException
    PostController --> Client: 404 Not Found
else User found
    opt media files provided
        loop for each media file
            CreatePostService -> FileStorageService: uploadFile(mediaFile)
            FileStorageService --> CreatePostService: mediaUrl
        end
    end

    CreatePostService -> CreatePostService: create Post entity\n(content, mediaUrls, visibility)

    CreatePostService -> PostRepository: save(post)
    PostRepository -> Database: INSERT INTO posts
    Database --> PostRepository: saved post
    PostRepository --> CreatePostService: Post

    CreatePostService --> PostController: CreatePostResponse
    deactivate CreatePostService

    PostController --> Client: 201 Created(response)
    deactivate PostController
end

alt Unauthorized
    AuthFilter --> Client: 401 Unauthorized
else Invalid request
    CreatePostService --> PostController: ValidationException
    PostController --> Client: 400 Bad Request
end

@enduml

@startuml
title GET /api/posts/{postId} - Get Post Details

actor Client
participant AuthFilter
participant PostController
participant GetPostService
participant PostRepository
participant UserRepository
participant PostMapper
database Database

Client -> AuthFilter: GET /api/posts/{postId}
AuthFilter -> AuthFilter: validate JWT (optional)
AuthFilter -> PostController: forward request with currentUserId (if authenticated)
activate PostController

PostController -> GetPostService: getPost(postId, currentUserId)
activate GetPostService

GetPostService -> PostRepository: findById(postId)
PostRepository -> Database: SELECT * FROM posts WHERE id = ?
Database --> PostRepository: post row
PostRepository --> GetPostService: Optional<Post>

alt Post not found
    GetPostService --> PostController: PostNotFoundException
    PostController --> Client: 404 Not Found
else Post found
    GetPostService -> GetPostService: check visibility\n(public/followers/private)

    alt Post is private and currentUserId != authorId
        GetPostService --> PostController: ForbiddenException
        PostController --> Client: 403 Forbidden
    else Post is followers-only
        opt currentUserId provided
            GetPostService -> GetPostService: check if following author

            alt Not following
                GetPostService --> PostController: ForbiddenException
                PostController --> Client: 403 Forbidden
            end
        end
    end

    GetPostService -> UserRepository: findById(post.authorId)
    UserRepository -> Database: SELECT * FROM users WHERE id = ?
    Database --> UserRepository: user row
    UserRepository --> GetPostService: Optional<User>

    opt currentUserId provided
        GetPostService -> GetPostService: check if liked by current user
        GetPostService -> GetPostService: check if bookmarked by current user
    end

    GetPostService -> PostMapper: toPostDetailResponse(post, author, isLiked, isBookmarked)
    PostMapper --> GetPostService: PostDetailResponse

    GetPostService --> PostController: PostDetailResponse
    deactivate GetPostService

    PostController --> Client: 200 OK(response)
    deactivate PostController
end

@enduml

@startuml
title PUT /api/posts/{postId} - Update Post

actor Client
participant AuthFilter
participant PostController
participant UpdatePostService
participant PostRepository
participant FileStorageService
database Database

Client -> AuthFilter: PUT /api/posts/{postId}(UpdatePostRequest)
AuthFilter -> AuthFilter: validate JWT
AuthFilter -> PostController: forward request with currentUserId
activate PostController

PostController -> UpdatePostService: updatePost(postId, currentUserId, request)
activate UpdatePostService

UpdatePostService -> PostRepository: findById(postId)
PostRepository -> Database: SELECT * FROM posts WHERE id = ?
Database --> PostRepository: post row
PostRepository --> UpdatePostService: Optional<Post>

alt Post not found
    UpdatePostService --> PostController: PostNotFoundException
    PostController --> Client: 404 Not Found
else Post found
    UpdatePostService -> UpdatePostService: check ownership\n(post.authorId == currentUserId)

    alt Not owner
        UpdatePostService --> PostController: ForbiddenException
        PostController --> Client: 403 Forbidden
    else Owner
        UpdatePostService -> UpdatePostService: validate request\n(content, media)

        opt new media files provided
            loop for each media file
                UpdatePostService -> FileStorageService: uploadFile(mediaFile)
                FileStorageService --> UpdatePostService: mediaUrl
            end
        end

        UpdatePostService -> UpdatePostService: update Post entity
        UpdatePostService -> PostRepository: save(post)
        PostRepository -> Database: UPDATE posts SET ... WHERE id = ?
        Database --> PostRepository: updated post
        PostRepository --> UpdatePostService: Post

        UpdatePostService --> PostController: UpdatePostResponse
        deactivate UpdatePostService

        PostController --> Client: 200 OK(response)
        deactivate PostController
    end
end

alt Unauthorized
    AuthFilter --> Client: 401 Unauthorized
end

@enduml

@startuml
title DELETE /api/posts/{postId} - Delete Post

actor Client
participant AuthFilter
participant PostController
participant DeletePostService
participant PostRepository
participant CommentRepository
participant LikeRepository
database Database

Client -> AuthFilter: DELETE /api/posts/{postId}
AuthFilter -> AuthFilter: validate JWT
AuthFilter -> PostController: forward request with currentUserId
activate PostController

PostController -> DeletePostService: deletePost(postId, currentUserId)
activate DeletePostService

DeletePostService -> PostRepository: findById(postId)
PostRepository -> Database: SELECT * FROM posts WHERE id = ?
Database --> PostRepository: post row
PostRepository --> DeletePostService: Optional<Post>

alt Post not found
    DeletePostService --> PostController: PostNotFoundException
    PostController --> Client: 404 Not Found
else Post found
    DeletePostService -> DeletePostService: check ownership\n(post.authorId == currentUserId)

    alt Not owner
        DeletePostService --> PostController: ForbiddenException
        PostController --> Client: 403 Forbidden
    else Owner
        DeletePostService -> DeletePostService: begin transaction

        DeletePostService -> LikeRepository: deleteByPostId(postId)
        LikeRepository -> Database: DELETE FROM likes WHERE post_id = ?
        Database --> LikeRepository: deleted count

        DeletePostService -> CommentRepository: deleteByPostId(postId)
        CommentRepository -> Database: DELETE FROM comments WHERE post_id = ?
        Database --> CommentRepository: deleted count

        DeletePostService -> PostRepository: delete(post)
        PostRepository -> Database: DELETE FROM posts WHERE id = ?
        Database --> PostRepository: void

        DeletePostService -> DeletePostService: commit transaction

        DeletePostService --> PostController: void
        deactivate DeletePostService

        PostController --> Client: 204 No Content
        deactivate PostController
    end
end

alt Unauthorized
    AuthFilter --> Client: 401 Unauthorized
end

@enduml

@startuml
title GET /api/posts - Get Posts Feed

actor Client
participant AuthFilter
participant PostController
participant GetPostsFeedService
participant PostRepository
participant UserRepository
participant PostMapper
database Database

Client -> AuthFilter: GET /api/posts?page={page}&size={size}&sort={sort}
AuthFilter -> AuthFilter: validate JWT (optional)
AuthFilter -> PostController: forward request with currentUserId (if authenticated)
activate PostController

PostController -> GetPostsFeedService: getPostsFeed(pageable, currentUserId)
activate GetPostsFeedService

alt currentUserId provided
    GetPostsFeedService -> GetPostsFeedService: get personalized feed\n(following + public)
    GetPostsFeedService -> PostRepository: findFeedForUser(currentUserId, pageable)
    PostRepository -> Database: SELECT p.* FROM posts p\nLEFT JOIN follows f ON p.author_id = f.followed_id\nWHERE f.follower_id = ? OR p.visibility = 'PUBLIC'\nORDER BY p.created_at DESC\nLIMIT ? OFFSET ?
else currentUserId not provided
    GetPostsFeedService -> GetPostsFeedService: get public feed
    GetPostsFeedService -> PostRepository: findPublicPosts(pageable)
    PostRepository -> Database: SELECT * FROM posts\nWHERE visibility = 'PUBLIC'\nORDER BY created_at DESC\nLIMIT ? OFFSET ?
end

Database --> PostRepository: post rows
PostRepository --> GetPostsFeedService: Page<Post>

loop for each post
    GetPostsFeedService -> UserRepository: findById(post.authorId)
    UserRepository -> Database: SELECT * FROM users WHERE id = ?
    Database --> UserRepository: user row
    UserRepository --> GetPostsFeedService: Optional<User>

    opt currentUserId provided
        GetPostsFeedService -> GetPostsFeedService: check if liked
        GetPostsFeedService -> GetPostsFeedService: check if bookmarked
    end

    GetPostsFeedService -> PostMapper: toPostResponse(post, author, isLiked, isBookmarked)
    PostMapper --> GetPostsFeedService: PostResponse
end

GetPostsFeedService --> PostController: Page<PostResponse>
deactivate GetPostsFeedService

PostController --> Client: 200 OK(response)
deactivate PostController

@enduml

@startuml
title GET /api/posts/user/{userId} - Get User Posts

actor Client
participant AuthFilter
participant PostController
participant GetUserPostsService
participant UserRepository
participant PostRepository
participant PostMapper
database Database

Client -> AuthFilter: GET /api/posts/user/{userId}?page={page}&size={size}
AuthFilter -> AuthFilter: validate JWT (optional)
AuthFilter -> PostController: forward request with currentUserId (if authenticated)
activate PostController

PostController -> GetUserPostsService: getUserPosts(userId, pageable, currentUserId)
activate GetUserPostsService

GetUserPostsService -> UserRepository: findById(userId)
UserRepository -> Database: SELECT * FROM users WHERE id = ?
Database --> UserRepository: user row
UserRepository --> GetUserPostsService: Optional<User>

alt User not found
    GetUserPostsService --> PostController: UserNotFoundException
    PostController --> Client: 404 Not Found
else User found
    alt currentUserId == userId
        GetUserPostsService -> PostRepository: findByAuthorId(userId, pageable)
        PostRepository -> Database: SELECT * FROM posts\nWHERE author_id = ?\nORDER BY created_at DESC\nLIMIT ? OFFSET ?
    else currentUserId != userId
        GetUserPostsService -> GetUserPostsService: check if following
        GetUserPostsService -> PostRepository: findVisiblePostsByAuthorId(userId, currentUserId, pageable)
        PostRepository -> Database: SELECT * FROM posts\nWHERE author_id = ?\nAND (visibility = 'PUBLIC'\n  OR (visibility = 'FOLLOWERS' AND EXISTS(...)))\nORDER BY created_at DESC\nLIMIT ? OFFSET ?
    end

    Database --> PostRepository: post rows
    PostRepository --> GetUserPostsService: Page<Post>

    loop for each post
        opt currentUserId provided
            GetUserPostsService -> GetUserPostsService: check if liked
            GetUserPostsService -> GetUserPostsService: check if bookmarked
        end

        GetUserPostsService -> PostMapper: toPostResponse(post, author, isLiked, isBookmarked)
        PostMapper --> GetUserPostsService: PostResponse
    end

    GetUserPostsService --> PostController: Page<PostResponse>
    deactivate GetUserPostsService

    PostController --> Client: 200 OK(response)
    deactivate PostController
end

@enduml
