@startuml
title GET /api/users/{userId} - Get User Profile

actor Client
participant AuthFilter
participant UserController
participant GetUserProfileService
participant UserRepository
participant UserMapper
database Database

Client -> AuthFilter: GET /api/users/{userId}
AuthFilter -> AuthFilter: validate JWT (optional)
AuthFilter -> UserController: forward request with currentUserId (if authenticated)
activate UserController

UserController -> GetUserProfileService: getUserProfile(userId, currentUserId)
activate GetUserProfileService

GetUserProfileService -> UserRepository: findById(userId)
UserRepository -> Database: SELECT * FROM users WHERE id = ?
Database --> UserRepository: user row
UserRepository --> GetUserProfileService: Optional<User>

alt User not found
    GetUserProfileService --> UserController: UserNotFoundException
    UserController --> Client: 404 Not Found
else User found
    GetUserProfileService -> GetUserProfileService: check visibility\n(public/private profile)

    opt currentUserId provided
        GetUserProfileService -> GetUserProfileService: check if following
        GetUserProfileService -> GetUserProfileService: check if blocked
    end

    GetUserProfileService -> UserMapper: toUserProfileResponse(user, isFollowing, isBlocked)
    UserMapper --> GetUserProfileService: UserProfileResponse

    GetUserProfileService --> UserController: UserProfileResponse
    deactivate GetUserProfileService

    UserController --> Client: 200 OK(response)
    deactivate UserController
end

@enduml

@startuml
title PUT /api/users/me - Update Current User Profile

actor Client
participant AuthFilter
participant UserController
participant UpdateUserProfileService
participant UserRepository
participant FileStorageService
database Database

Client -> AuthFilter: PUT /api/users/me(UpdateProfileRequest)
AuthFilter -> AuthFilter: validate JWT
AuthFilter -> UserController: forward request with currentUserId
activate UserController

UserController -> UpdateUserProfileService: updateProfile(currentUserId, request)
activate UpdateUserProfileService

UpdateUserProfileService -> UserRepository: findById(currentUserId)
UserRepository -> Database: SELECT * FROM users WHERE id = ?
Database --> UserRepository: user row
UserRepository --> UpdateUserProfileService: Optional<User>

alt User not found
    UpdateUserProfileService --> UserController: UserNotFoundException
    UserController --> Client: 404 Not Found
else User found
    UpdateUserProfileService -> UpdateUserProfileService: validate request\n(bio length, display name)

    opt username changed
        UpdateUserProfileService -> UserRepository: existsByUsername(newUsername)
        UserRepository -> Database: SELECT COUNT(*) WHERE username = ?
        Database --> UserRepository: count
        UserRepository --> UpdateUserProfileService: boolean

        alt Username taken
            UpdateUserProfileService --> UserController: UsernameAlreadyExistsException
            UserController --> Client: 409 Conflict
        end
    end

    opt avatar uploaded
        UpdateUserProfileService -> FileStorageService: uploadFile(avatarFile)
        FileStorageService --> UpdateUserProfileService: avatarUrl
    end

    UpdateUserProfileService -> UpdateUserProfileService: update User entity
    UpdateUserProfileService -> UserRepository: save(user)
    UserRepository -> Database: UPDATE users SET ... WHERE id = ?
    Database --> UserRepository: updated user
    UserRepository --> UpdateUserProfileService: User

    UpdateUserProfileService --> UserController: UserProfileResponse
    deactivate UpdateUserProfileService

    UserController --> Client: 200 OK(response)
    deactivate UserController
end

alt Unauthorized
    AuthFilter --> Client: 401 Unauthorized
end

@enduml

