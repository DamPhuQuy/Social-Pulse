@startuml
title POST /api/admin/users/{userId}/suspend - Suspend User (Admin)

actor Client
participant AuthFilter
participant RoleAuthorizationFilter
participant AdminController
participant SuspendUserService
participant UserRepository
participant PostRepository
participant CommentRepository
database Database

Client -> AuthFilter: POST /api/admin/users/{userId}/suspend(SuspendUserRequest)
AuthFilter -> AuthFilter: validate JWT
AuthFilter -> RoleAuthorizationFilter: check role
RoleAuthorizationFilter -> RoleAuthorizationFilter: verify ADMIN role

alt Not authorized
    RoleAuthorizationFilter --> Client: 403 Forbidden
else Authorized
    RoleAuthorizationFilter -> AdminController: forward request with currentUserId
    activate AdminController

    AdminController -> SuspendUserService: suspendUser(userId, currentUserId, request)
    activate SuspendUserService

    SuspendUserService -> UserRepository: findById(userId)
    UserRepository -> Database: SELECT * FROM users WHERE id = ?
    Database --> UserRepository: user row
    UserRepository --> SuspendUserService: Optional<User>

    alt User not found
        SuspendUserService --> AdminController: UserNotFoundException
        AdminController --> Client: 404 Not Found
    else User found
        SuspendUserService -> SuspendUserService: validate not suspending admin

        alt Target is admin
            SuspendUserService --> AdminController: InvalidOperationException
            AdminController --> Client: 400 Bad Request
        else Valid operation
            SuspendUserService -> SuspendUserService: begin transaction

            SuspendUserService -> SuspendUserService: update User entity\n(status = SUSPENDED, suspendedAt, suspendReason)

            SuspendUserService -> UserRepository: save(user)
            UserRepository -> Database: UPDATE users SET status = 'SUSPENDED',\nsuspended_at = ?, suspend_reason = ?\nWHERE id = ?
            Database --> UserRepository: updated user
            UserRepository --> SuspendUserService: User

            opt hideContent == true
                SuspendUserService -> PostRepository: hidePostsByUserId(userId)
                PostRepository -> Database: UPDATE posts SET is_hidden = true\nWHERE author_id = ?
                Database --> PostRepository: updated count

                SuspendUserService -> CommentRepository: hideCommentsByUserId(userId)
                CommentRepository -> Database: UPDATE comments SET is_hidden = true\nWHERE author_id = ?
                Database --> CommentRepository: updated count
            end

            SuspendUserService -> SuspendUserService: commit transaction

            SuspendUserService --> AdminController: SuspendUserResponse
            deactivate SuspendUserService

            AdminController --> Client: 200 OK(response)
            deactivate AdminController
        end
    end
end

alt Unauthorized
    AuthFilter --> Client: 401 Unauthorized
end

@enduml

@startuml
title POST /api/admin/users/{userId}/unsuspend - Unsuspend User (Admin)

actor Client
participant AuthFilter
participant RoleAuthorizationFilter
participant AdminController
participant UnsuspendUserService
participant UserRepository
participant PostRepository
participant CommentRepository
database Database

Client -> AuthFilter: POST /api/admin/users/{userId}/unsuspend
AuthFilter -> AuthFilter: validate JWT
AuthFilter -> RoleAuthorizationFilter: check role
RoleAuthorizationFilter -> RoleAuthorizationFilter: verify ADMIN role

alt Not authorized
    RoleAuthorizationFilter --> Client: 403 Forbidden
else Authorized
    RoleAuthorizationFilter -> AdminController: forward request with currentUserId
    activate AdminController

    AdminController -> UnsuspendUserService: unsuspendUser(userId, currentUserId)
    activate UnsuspendUserService

    UnsuspendUserService -> UserRepository: findById(userId)
    UserRepository -> Database: SELECT * FROM users WHERE id = ?
    Database --> UserRepository: user row
    UserRepository --> UnsuspendUserService: Optional<User>

    alt User not found
        UnsuspendUserService --> AdminController: UserNotFoundException
        AdminController --> Client: 404 Not Found
    else User found
        UnsuspendUserService -> UnsuspendUserService: validate user is suspended

        alt User not suspended
            UnsuspendUserService --> AdminController: InvalidOperationException
            AdminController --> Client: 400 Bad Request
        else User suspended
            UnsuspendUserService -> UnsuspendUserService: begin transaction

            UnsuspendUserService -> UnsuspendUserService: update User entity\n(status = ACTIVE, suspendedAt = null, suspendReason = null)

            UnsuspendUserService -> UserRepository: save(user)
            UserRepository -> Database: UPDATE users SET status = 'ACTIVE',\nsuspended_at = NULL, suspend_reason = NULL\nWHERE id = ?
            Database --> UserRepository: updated user
            UserRepository --> UnsuspendUserService: User

            UnsuspendUserService -> PostRepository: unhidePostsByUserId(userId)
            PostRepository -> Database: UPDATE posts SET is_hidden = false\nWHERE author_id = ?
            Database --> PostRepository: updated count

            UnsuspendUserService -> CommentRepository: unhideCommentsByUserId(userId)
            CommentRepository -> Database: UPDATE comments SET is_hidden = false\nWHERE author_id = ?
            Database --> CommentRepository: updated count

            UnsuspendUserService -> UnsuspendUserService: commit transaction

            UnsuspendUserService --> AdminController: UnsuspendUserResponse
            deactivate UnsuspendUserService

            AdminController --> Client: 200 OK(response)
            deactivate AdminController
        end
    end
end

alt Unauthorized
    AuthFilter --> Client: 401 Unauthorized
end

@enduml

@startuml
title GET /api/admin/users - Get All Users (Admin)

actor Client
participant AuthFilter
participant RoleAuthorizationFilter
participant AdminController
participant GetAllUsersService
participant UserRepository
participant UserMapper
database Database

Client -> AuthFilter: GET /api/admin/users?status={status}&role={role}&page={page}&size={size}
AuthFilter -> AuthFilter: validate JWT
AuthFilter -> RoleAuthorizationFilter: check role
RoleAuthorizationFilter -> RoleAuthorizationFilter: verify ADMIN or MODERATOR role

alt Not authorized
    RoleAuthorizationFilter --> Client: 403 Forbidden
else Authorized
    RoleAuthorizationFilter -> AdminController: forward request with currentUserId
    activate AdminController

    AdminController -> GetAllUsersService: getAllUsers(status, role, pageable)
    activate GetAllUsersService

    GetAllUsersService -> UserRepository: findByStatusAndRole(status, role, pageable)
    UserRepository -> Database: SELECT * FROM users\nWHERE status = ? AND role = ?\nORDER BY created_at DESC\nLIMIT ? OFFSET ?
    Database --> UserRepository: user rows
    UserRepository --> GetAllUsersService: Page<User>

    loop for each user
        GetAllUsersService -> UserMapper: toAdminUserResponse(user)
        UserMapper --> GetAllUsersService: AdminUserResponse
    end

    GetAllUsersService --> AdminController: Page<AdminUserResponse>
    deactivate GetAllUsersService

    AdminController --> Client: 200 OK(response)
    deactivate AdminController
end

alt Unauthorized
    AuthFilter --> Client: 401 Unauthorized
end

@enduml

@startuml
title GET /api/admin/statistics - Get Platform Statistics (Admin)

actor Client
participant AuthFilter
participant RoleAuthorizationFilter
participant AdminController
participant GetStatisticsService
participant UserRepository
participant PostRepository
participant CommentRepository
participant ReportRepository
database Database

Client -> AuthFilter: GET /api/admin/statistics
AuthFilter -> AuthFilter: validate JWT
AuthFilter -> RoleAuthorizationFilter: check role
RoleAuthorizationFilter -> RoleAuthorizationFilter: verify ADMIN role

alt Not authorized
    RoleAuthorizationFilter --> Client: 403 Forbidden
else Authorized
    RoleAuthorizationFilter -> AdminController: forward request with currentUserId
    activate AdminController

    AdminController -> GetStatisticsService: getStatistics()
    activate GetStatisticsService

    GetStatisticsService -> UserRepository: countAll()
    UserRepository -> Database: SELECT COUNT(*) FROM users
    Database --> UserRepository: count
    UserRepository --> GetStatisticsService: totalUsers

    GetStatisticsService -> UserRepository: countByStatus(ACTIVE)
    UserRepository -> Database: SELECT COUNT(*) FROM users WHERE status = 'ACTIVE'
    Database --> UserRepository: count
    UserRepository --> GetStatisticsService: activeUsers

    GetStatisticsService -> PostRepository: countAll()
    PostRepository -> Database: SELECT COUNT(*) FROM posts
    Database --> PostRepository: count
    PostRepository --> GetStatisticsService: totalPosts

    GetStatisticsService -> CommentRepository: countAll()
    CommentRepository -> Database: SELECT COUNT(*) FROM comments
    Database --> CommentRepository: count
    CommentRepository --> GetStatisticsService: totalComments

    GetStatisticsService -> ReportRepository: countByStatus(PENDING)
    ReportRepository -> Database: SELECT COUNT(*) FROM reports WHERE status = 'PENDING'
    Database --> ReportRepository: count
    ReportRepository --> GetStatisticsService: pendingReports

    GetStatisticsService -> GetStatisticsService: aggregate statistics

    GetStatisticsService --> AdminController: StatisticsResponse
    deactivate GetStatisticsService

    AdminController --> Client: 200 OK(response)
    deactivate AdminController
end

alt Unauthorized
    AuthFilter --> Client: 401 Unauthorized
end

@enduml

@startuml
title DELETE /api/admin/posts/{postId} - Delete Post (Admin)

actor Client
participant AuthFilter
participant RoleAuthorizationFilter
participant AdminController
participant AdminDeletePostService
participant PostRepository
participant CommentRepository
participant LikeRepository
database Database

Client -> AuthFilter: DELETE /api/admin/posts/{postId}
AuthFilter -> AuthFilter: validate JWT
AuthFilter -> RoleAuthorizationFilter: check role
RoleAuthorizationFilter -> RoleAuthorizationFilter: verify ADMIN or MODERATOR role

alt Not authorized
    RoleAuthorizationFilter --> Client: 403 Forbidden
else Authorized
    RoleAuthorizationFilter -> AdminController: forward request with currentUserId
    activate AdminController

    AdminController -> AdminDeletePostService: deletePost(postId, currentUserId)
    activate AdminDeletePostService

    AdminDeletePostService -> PostRepository: findById(postId)
    PostRepository -> Database: SELECT * FROM posts WHERE id = ?
    Database --> PostRepository: post row
    PostRepository --> AdminDeletePostService: Optional<Post>

    alt Post not found
        AdminDeletePostService --> AdminController: PostNotFoundException
        AdminController --> Client: 404 Not Found
    else Post found
        AdminDeletePostService -> AdminDeletePostService: begin transaction

        AdminDeletePostService -> LikeRepository: deleteByPostId(postId)
        LikeRepository -> Database: DELETE FROM likes WHERE post_id = ?
        Database --> LikeRepository: deleted count

        AdminDeletePostService -> CommentRepository: deleteByPostId(postId)
        CommentRepository -> Database: DELETE FROM comments WHERE post_id = ?
        Database --> CommentRepository: deleted count

        AdminDeletePostService -> PostRepository: delete(post)
        PostRepository -> Database: DELETE FROM posts WHERE id = ?
        Database --> PostRepository: void

        AdminDeletePostService -> AdminDeletePostService: commit transaction
        AdminDeletePostService -> AdminDeletePostService: log admin action

        AdminDeletePostService --> AdminController: void
        deactivate AdminDeletePostService

        AdminController --> Client: 204 No Content
        deactivate AdminController
    end
end

alt Unauthorized
    AuthFilter --> Client: 401 Unauthorized
end

@enduml
