@startuml Auth Module

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false

title Auth Module - Domain Model

class RefreshToken {
    - id: UUID
    - userId: Long
    - tokenHash: String
    - expiresAt: LocalDateTime
    - createdAt: LocalDateTime
    - revokedAt: LocalDateTime
    - replacedByToken: UUID
}

class Otp {
    - email: String
    - otpCode: String
    - expiredAt: Long
    - attemptCount: Long
}

note right of Otp : Stored in Redis\n(no JPA entity)

@enduml
