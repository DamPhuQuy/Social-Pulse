@startuml Other Modules

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false

title Bookmark, Follow, Notification, Report, Feed - Domain Models

' === Bookmark ===
package "bookmark.domain" {
    class Bookmark {
        - id: Long
        - userId: Long
        - postId: Long
        - createdAt: LocalDateTime
    }
}

' === Follow ===
package "follow.domain" {
    class Follow {
        - id: Long
        - followerId: Long
        - followingId: Long
        - createdAt: LocalDateTime
    }
}

' === Notification ===
package "notification.domain" {
    enum NotificationType {
        FOLLOWED_YOU
        POST_REACTED
        COMMENTED_ON_POST
        REPLIED_TO_COMMENT
        COMMENT_REACTED
    }

    enum NotificationResourceType {
        USER
        POST
        COMMENT
    }

    class Notification {
        - id: Long
        - recipientId: Long
        - actorId: Long
        - type: NotificationType
        - resourceType: NotificationResourceType
        - resourceId: Long
        - message: String
        - createdAt: LocalDateTime
        - readAt: LocalDateTime
    }
}

' === Report ===
package "report.domain" {
    enum ReportStatus {
        PENDING
        RESOLVED
        REJECTED
    }

    enum ReportTargetType {
        POST
        COMMENT
        USER
    }

    class Report {
        - id: Long
        - reporterId: Long
        - targetType: ReportTargetType
        - targetId: Long
        - reason: String
        - status: ReportStatus
        - createdAt: LocalDateTime
    }
}

' === Feed ===
package "feed.domain" {
    enum Source {
        RECENT
        FOLLOWING
        POPULAR
        RANDOM
    }

    class FeedItem {
        - postId: Long
        - userId: Long
        - aiScore: Double
        - source: Source
        - rankedAt: LocalDateTime
    }

    class CandidatePost {
        - post: Post
        - source: Source
    }
}

' Relationships
Notification ..> NotificationType
Notification ..> NotificationResourceType
Report ..> ReportStatus
Report ..> ReportTargetType
FeedItem ..> Source
CandidatePost ..> Source

@enduml
